# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Next.js
# NOTE: these are anchored to the repo/app root on purpose. An unanchored
# "build/" would also match app route segments such as
# app/projects/[projectId]/build/ and silently drop real source files.
.next/
/out/
/frontend/out/
/build/
/frontend/build/
/dist/
/frontend/dist/

# Production
*.tsbuildinfo
next-env.d.ts

# Environment
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Testing
/coverage/
/frontend/coverage/

# Caches
.turbo/
.cache/
.eslintcache

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo

# Vercel
.vercel
